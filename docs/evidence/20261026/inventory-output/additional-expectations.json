      "operation": "Admit with nil plan, zero-value plan, then caller-built public diagnostics copied from valid plan without private constructor state",
      "want_each_error": "required_evidence_invalid",
      "want_each_nil": true
    },
    {
      "name": "constructor-input-ownership",
      "operation": "Build baseline; mutate original selected/declarations/resource strings and Tags; admit with original literal request/collections",
      "want_equals_baseline": true,
      "want_original_plan_unchanged": true
    },
    {
      "name": "plan-diagnostic-mutation-resistance",
      "operation": "Build baseline; mutate public Resources, Requirements nested SKUs/Kinds/IDs, Scopes and Status; admit literal baseline request/collections",
      "want_equals_baseline": true
    },
    {
      "name": "admission-input-ownership",
      "operation": "Admit baseline; mutate original typed payload metadata/maps/zones; call Evidence",
      "want_request_equals_baseline": true,
      "want_values_equal_baseline": true
    },
    {
      "name": "accessor-deep-copy",
      "operation": "Mutate public admission Request/SKUs/Catalogs and first Evidence result request/maps/zones; call Evidence again",
      "want_request_equals_baseline": true,
      "want_values_equal_baseline": true,
      "want_aliasing": false
    },
    {
      "name": "zero-admission-accessor",
      "operation": "Evidence on zero/nil admission",
      "want_request_zero": true,
      "want_non_nil_empty_values": true,
      "want_panic": false
    },
    {
      "name": "repeat-and-concurrent-isolation",
      "operation": "Separate Build/Admit calls with stable shared inputs, then concurrent Evidence calls; mutate one returned result only after all calls return",
      "want_all_equal_baseline": true,
      "want_cross_result_aliasing": false,
      "requires_native_race_check": true
    },
    {
      "name": "terminal-context-priority",
      "operation": "At entry use already canceled/deadline contexts with invalid and over-limit inputs on both APIs",
      "want_each_nil": true,
      "want_errors_is_context_cause": true,
      "want_fixed_input_error": false
    },
    {
      "name": "late-terminal-context",
      "operation": "Cancel/deadline after bounded input work and before publication, with concurrent late invalid-tail condition",
      "want_each_nil": true,
      "want_errors_is_context_cause": true,
      "schedule": "OPEN: deterministic phase synchronization required before freeze; no sleeps or implementation-derived Err-count schedule",
